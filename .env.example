# ═══════════════════════════════════════
# Stairs — Environment Variables
# Copy to .env and fill in your values
# ═══════════════════════════════════════

# Database (Railway auto-injects this when you add PostgreSQL)
DATABASE_URL=postgresql://stairs:stairs2026@localhost:5432/stairs

# JWT Auth — REQUIRED. The server refuses to start without it.
# Every organization's data is protected by the "org" claim in this token, so a
# guessable key is a master key for the whole system. Generate a real one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Verify an existing one without revealing it:
#   python backend/scripts/check_jwt_secret.py
JWT_SECRET=
JWT_EXPIRY_HOURS=72

# CORS — comma-separated origins, e.g. https://app.example.com,https://staging.example.com
# "*" is NOT honoured: this API sends credentials, and wildcard-with-credentials
# is invalid per the CORS spec. Leaving this unset allows only localhost and
# *.vercel.app.
ALLOWED_ORIGINS=

# AI (optional — mock AI works without this)
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514

# Railway injects this automatically
PORT=8000

# ─── FRONTEND (build-time, read by Vite) ───
# Which backend the built front end talks to. Defaults to production when unset,
# so nothing changes for the production deploy. Set it on preview deployments to
# point them at a staging backend — today every preview talks to the production
# API against real client data.
VITE_API_URL=
